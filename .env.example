# Copy to .env and fill in real values. Never commit .env.

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/?payment=callback
PAYSTACK_FRONTEND_CALLBACK_URL=http://127.0.0.1:3000/?payment=callback

# Resend (preferred for production OTP — https://resend.com)
RESEND_API_KEY=
MAIL_FROM="skyWash <onboarding@resend.dev>"
MAIL_ENABLED=true

# Optional local fallback: Mailtrap SMTP (testing inbox only)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps Geocoding (restrict key to Geocoding API in Cloud Console).
# If unset, OpenStreetMap Nominatim is used so pickups are not forced into Nigeria.
GOOGLE_MAPS_API_KEY=
# GEOCODE_NOMINATIM=true

# Meta Llama via OpenAI-compatible host (skyWash Assist)
# Get a free key at https://console.groq.com/keys (Llama 3.3) or use Together/Fireworks/Meta Llama API
LLAMA_API_KEY=
# Optional aliases / overrides:
# META_LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.3-70b-versatile

# Human support (Assist escalation)
SUPPORT_EMAIL=isaac.arinze.dev@gmail.com

# Partner ops dashboard (GITEX demo PIN) + notify channels
OPS_PIN=skywash-ops
PARTNER_NOTIFY_FALLBACK_EMAIL=isaac.arinze.dev@gmail.com
# Optional Meta WhatsApp Cloud API — if unset, ops shows wa.me deep link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Postgres (local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/skywash
SPRING_DATASOURCE_USERNAME=skywash
SPRING_DATASOURCE_PASSWORD=skywash
