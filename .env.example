# Copy to .env and fill in real values. Never commit .env.

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:3000/?payment=callback
PAYSTACK_FRONTEND_CALLBACK_URL=http://127.0.0.1:3000/?payment=callback

# Resend (preferred for production OTP — https://resend.com)
RESEND_API_KEY=
MAIL_FROM="skyWash <onboarding@resend.dev>"
MAIL_ENABLED=true

# Optional local fallback: Mailtrap SMTP (testing inbox only)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps Geocoding (restrict key to Geocoding API in Cloud Console)
GOOGLE_MAPS_API_KEY=

# Gemini (partner chat replies — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Postgres (local)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/skywash
SPRING_DATASOURCE_USERNAME=skywash
SPRING_DATASOURCE_PASSWORD=skywash
